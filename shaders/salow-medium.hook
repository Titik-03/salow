    result += mat4(-0.0014587149489670992, -0.01664533093571663, -0.009796195663511753, 0.0, -0.04129808768630028, -0.04460357502102852, -0.041341524571180344, 0.0, -0.00786341167986393, -0.01137475948780775, -0.012389559298753738, 0.0, 0.12787343561649323, 0.13099613785743713, 0.1138557568192482, 0.0) * go_1(-1.0, 1.0);
    result += mat4(0.13069793581962585, 0.11647197604179382, 0.12174593657255173, 0.0, -0.1509723961353302, -0.14456918835639954, -0.1322355419397354, 0.0, 0.27219924330711365, 0.28092825412750244, 0.2581842243671417, 0.0, -0.0656784251332283, -0.08127091079950333, -0.08339762687683105, 0.0) * go_0(0.0, 1.0);
    result += mat4(-0.03627261519432068, -0.020147118717432022, -0.027314430102705956, 0.0, 0.15805144608020782, 0.1492004096508026, 0.12841133773326874, 0.0, -0.06105250492691994, -0.04537979140877724, -0.053769975900650024, 0.0, 0.19120369851589203, 0.20567192137241364, 0.19657078385353088, 0.0) * go_1(0.0, 1.0);
    result += mat4(0.0878870040178299, 0.1108584776520729, 0.09454237669706345, 0.0, -0.04076489433646202, -0.061530210077762604, -0.053926050662994385, 0.0, 0.05822074040770531, 0.060126982629299164, 0.05955737084150314, 0.0, 0.03839801624417305, 0.030335528776049614, 0.029958292841911316, 0.0) * go_0(1.0, 1.0);
    result += mat4(0.06666022539138794, 0.06607641279697418, 0.07460898160934448, 0.0, 0.1393478512763977, 0.1713658720254898, 0.14875996112823486, 0.0, 0.20907986164093018, 0.22458939254283905, 0.19775448739528656, 0.0, -0.032421573996543884, -0.03471468389034271, -0.03231510892510414, 0.0) * go_1(1.0, 1.0);
    result += vec4(-0.03934042900800705, -0.03991636261343956, -0.03021858073771, 0.0);
    vec4 src = HOOKED_tex(HOOKED_pos);
    vec4 y = vec4(result.rgb + src.rgb, src.a);
    const vec3 W = vec3(0.299, 0.587, 0.114);
    float g = 0.0;
    for (int j = -2; j <= 2; j++) for (int i = -2; i <= 2; i++) g = max(g, dot(W, HOOKED_texOff(vec2(i, j)).rgb));
#define LY(x, y) dot(W, HOOKED_texOff(vec2(x, y)).rgb)
    // Thin dark lines in dim areas: match A+A's line depth (Salow draws them lighter there).
    float rd = max(max(min(LY(-2, 0), LY(2, 0)), min(LY(0, -2), LY(0, 2))), max(min(LY(-2, -2), LY(2, 2)), min(LY(2, -2), LY(-2, 2)))) - dot(W, src.rgb);
    rd = max(rd, 0.0);
    float k = 0.19 * smoothstep(20.0/255.0, 45.0/255.0, g) * (1.0 - smoothstep(55.0/255.0, 150.0/255.0, g));
    y.rgb -= k * min(rd, 40.0/255.0) * smoothstep(3.0/255.0, 8.0/255.0, rd);
    y.rgb -= max(dot(W, y.rgb) - g, 0.0);
    // Steady: where the source pixel and Salow's correction barely changed since the last frame,
    // average the correction with the previous one (removes amplified codec-noise shimmer).
    ivec2 p = ivec2(gl_FragCoord.xy);
    vec4 prev = imageLoad(SALOW_PREV, p);
    vec3 res = y.rgb - src.rgb;
    float ls = dot(W, src.rgb);
    float dres = max(max(abs(res.r - prev.r), abs(res.g - prev.g)), abs(res.b - prev.b));
    float w = 0.6 * (1.0 - smoothstep(1.0/255.0, 3.0/255.0, dres)) * (1.0 - smoothstep(1.0/255.0, 3.0/255.0, abs(ls - prev.a)));
    if (any(greaterThanEqual(p, ivec2(1920, 1080)))) w = 0.0;
    res = mix(res, prev.rgb, w);
    imageStore(SALOW_PREV, p, vec4(res, ls));
    return vec4(src.rgb + res, y.a);
}
